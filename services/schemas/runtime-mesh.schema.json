{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marcmunoz-uno/parallel-OS/services/schemas/runtime-mesh.schema.json",
  "title": "parallel-OS Runtime Mesh",
  "type": "object",
  "required": ["version", "routing_defaults", "runtimes"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "routing_defaults": {
      "type": "object",
      "required": ["max_fanout", "min_capability_overlap"],
      "properties": {
        "max_fanout": { "type": "integer", "minimum": 1 },
        "min_capability_overlap": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["service", "runtime", "enabled", "capability_tags"],
        "properties": {
          "service": { "type": "string", "minLength": 1 },
          "runtime": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "preferred": { "type": "boolean" },
          "trust_tier": {
            "type": "string",
            "enum": ["trusted", "constrained", "untrusted"]
          },
          "max_parallel_jobs": { "type": "integer", "minimum": 1 },
          "capability_tags": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
